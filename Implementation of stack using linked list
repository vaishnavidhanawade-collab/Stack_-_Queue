#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node *next;
};

Node *top = NULL;

void push(int x)
{
    Node *newnode = new Node;
    newnode->data = x;
    newnode->next = top;
    top = newnode;

    cout << x << " inserted\n";
}

void pop()
{
    if (top == NULL)
        cout << "Stack is Empty\n";
    else
    {
        Node *temp = top;
        cout << "Deleted: " << top->data << endl;
        top = top->next;
        delete temp;
    }
}

void display()
{
    if (top == NULL)
        cout << "Stack is Empty\n";
    else
    {
        Node *temp = top;

        while (temp != NULL)
        {
            cout << temp->data << " ";
            temp = temp->next;
        }
        cout << endl;
    }
}

int main()
{
    push(10);
    push(20);
    push(30);

    display();

    pop();

    display();

    return 0;
}
