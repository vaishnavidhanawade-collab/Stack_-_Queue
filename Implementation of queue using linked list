#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node *next;
};

Node *front = NULL;
Node *rear = NULL;

void enqueue(int x)
{
    Node *newnode = new Node;
    newnode->data = x;
    newnode->next = NULL;

    if (front == NULL)
        front = rear = newnode;
    else
    {
        rear->next = newnode;
        rear = newnode;
    }

    cout << x << " inserted\n";
}

void dequeue()
{
    if (front == NULL)
        cout << "Queue is Empty\n";
    else
    {
        Node *temp = front;
        cout << "Deleted: " << front->data << endl;

        front = front->next;

        if (front == NULL)
            rear = NULL;

        delete temp;
    }
}

void display()
{
    if (front == NULL)
        cout << "Queue is Empty\n";
    else
    {
        Node *temp = front;

        while (temp != NULL)
        {
            cout << temp->data << " ";
            temp = temp->next;
        }
        cout << endl;
    }
}

int main()
{
    enqueue(10);
    enqueue(20);
    enqueue(30);

    display();

    dequeue();

    display();

    return 0;
}
